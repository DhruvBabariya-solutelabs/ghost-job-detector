    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
