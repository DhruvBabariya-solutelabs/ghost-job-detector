{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["chrome", "node"]
  },
  "include": [
    "src",
    "entrypoints",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ],
  "exclude": ["node_modules", ".output", ".wxt/types"]
}
