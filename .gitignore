# Dependencies
node_modules/

# Build outputs
.next/
.turbo/
.wxt/
dist/
.output/

# apps/web/public/extension.zip is intentionally committed so Vercel serves it
# statically — Vercel runs `next build` directly and skips the npm `prebuild`
# hook that would otherwise generate it.

# TypeScript incremental build info (generated by tsc/Next.js)
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# Lockfiles from other package managers (we use npm)
pnpm-lock.yaml
yarn.lock
bun.lockb

.planning/
.claude/